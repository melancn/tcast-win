<Window x:Class="TCast.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TCast.Desktop.Views"
        xmlns:vm="clr-namespace:TCast.Desktop.ViewModels"
        Icon="/TCast.Desktop;component/Assets/app-icon.ico"
        Title="TCast Desktop" Width="1440" Height="960" MinWidth="640" MinHeight="480"
        Background="{StaticResource App.Background}" FontFamily="{StaticResource App.Font}" FontSize="14"
        Foreground="{StaticResource App.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded" SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp" Deactivated="OnWindowDeactivated">
  <Window.Resources>
    <DataTemplate x:Key="NavigationTemplate">
      <Border Background="White" BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,0">
          <StackPanel DockPanel.Dock="Top" Margin="12,32,0,4">
            <StackPanel Orientation="Horizontal">
              <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource App.Primary}" Margin="0,0,12,0">
                <Path Style="{StaticResource App.Icon}" Data="{StaticResource Icon.Tv}" Stroke="White" Width="22" Height="22" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TCast" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="D E S K T O P" FontSize="9" Foreground="{StaticResource App.TextMuted}" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="工作空间" Style="{StaticResource App.MutedText}" Margin="0,38,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,20">
            <Border BorderBrush="{StaticResource App.Border}" BorderThickness="1" Background="{StaticResource App.SurfaceMuted}" CornerRadius="10" Padding="14">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource App.Icon}" Data="{StaticResource Icon.Network}" Stroke="{StaticResource App.Primary}" Width="16" Height="16" Margin="0,0,8,0" />
                  <TextBlock Text="局域网工作模式" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="Wi-Fi · 以所选网卡为准" Style="{StaticResource App.MutedText}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="仅限本人或已授权设备" Style="{StaticResource App.MutedText}" FontSize="10" Margin="14,18,0,0" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding NavigationItems}" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource App.Navigation}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" Click="OnNavigationChosen">
                  <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,14,0">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource App.Icon}">
                          <Setter Property="Data" Value="{StaticResource Icon.Tv}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="remote"><Setter Property="Data" Value="{StaticResource Icon.Remote}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="apk"><Setter Property="Data" Value="{StaticResource Icon.Apk}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="diagnostics"><Setter Property="Data" Value="{StaticResource Icon.Diagnostics}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}"><views:DiscoveryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:RemoteViewModel}"><views:RemoteView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ApkViewModel}"><views:ApkView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource App.Background}">
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="NavToggle" DockPanel.Dock="Left" Width="44" Height="40" Padding="12" Margin="12,0,8,0"
                Style="{StaticResource App.SecondaryButton}" BorderThickness="0" Click="OnToggleNavigation" AutomationProperties.Name="显示或隐藏导航">
          <Path Style="{StaticResource App.Icon}" Data="{StaticResource Icon.Menu}" Width="16" Height="16" />
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource App.Primary}" CornerRadius="4" Width="16" Height="16" Margin="0,0,10,0">
            <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="TCast Desktop" Style="{StaticResource App.MutedText}" />
          <TextBlock Text=" /   Windows 客户端" Style="{StaticResource App.MutedText}" Margin="12,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="214" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ContentControl x:Name="DesktopNavigation" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      ContentTemplate="{StaticResource NavigationTemplate}" />
      <Grid Grid.Column="1" x:Name="Workspace">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#FBFCFF" BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1" Padding="28,10" MinHeight="59">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="断开连接" Command="{Binding DisconnectCommand}" Style="{StaticResource App.SecondaryButton}" Margin="12,0,0,0" />
            <Path DockPanel.Dock="Left" Style="{StaticResource App.Icon}" Data="{StaticResource Icon.Link}" Stroke="{StaticResource App.TextMuted}" Width="18" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="当前控制目标" Style="{StaticResource App.MutedText}" FontSize="10" />
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{Binding ConnectionIndicatorBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ConnectionText}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="MainContent" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,24">
          <StackPanel>
            <TextBlock Text="{Binding WorkspaceLabel}" FontSize="10" Foreground="{StaticResource App.Primary}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="{Binding PageHeading}" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PageDescription}" Style="{StaticResource App.MutedText}" Margin="0,6,0,20" />
            <ContentControl Content="{Binding CurrentPage}" />
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Path Style="{StaticResource App.Icon}" Data="{StaticResource Icon.Shield}" Stroke="{StaticResource App.TextMuted}" Width="12" Height="12" Margin="0,0,8,0" />
              <TextBlock Text="仅连接你拥有或明确授权的设备 · 不会扫描同网段外的地址" Style="{StaticResource App.MutedText}" FontSize="10" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="DrawerLayer" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
        <Button Background="{StaticResource App.Overlay}" BorderThickness="0" Focusable="False" Click="OnCloseDrawer" AutomationProperties.Name="关闭导航遮罩" />
        <Border Width="246" HorizontalAlignment="Left" Background="White">
          <DockPanel x:Name="DrawerFocusScope" KeyboardNavigation.TabNavigation="Cycle">
            <Button DockPanel.Dock="Top" Content="关闭导航" Style="{StaticResource App.SecondaryButton}" Margin="16,12" Click="OnCloseDrawer" />
            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ContentTemplate="{StaticResource NavigationTemplate}" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
